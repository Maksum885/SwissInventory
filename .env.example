APP_NAME="SWIS Inventory Tracking"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Koneksi utama: schema db_swis (warehouse_stock, bom_list, matrix_partcode, dst).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=db_swis
DB_USERNAME=postgres
DB_PASSWORD=

# Koneksi kedua: schema db_agv (status rak/bin dari sistem AGV) — dipakai READ-ONLY
# oleh web app ini. Kalau di PC produksi kedua database ini jalan di host/port yang
# sama, isi persis sama dengan DB_HOST/DB_PORT di atas; kalau di server terpisah,
# sesuaikan sendiri.
DB_AGV_HOST=127.0.0.1
DB_AGV_PORT=5432
DB_AGV_DATABASE=postgres
DB_AGV_SCHEMA=db_agv
DB_AGV_USERNAME=postgres
DB_AGV_PASSWORD=

# File-based, bukan database — app ini read-only, tidak perlu (dan sebaiknya tidak)
# menulis tabel sessions/cache/jobs ke database db_swis yang dipakai bareng AGV.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
